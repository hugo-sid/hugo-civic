# Dependencies
node_modules
package-lock.json

# Hugo build output. Unanchored, so they match at any depth — exampleSite/public
# and exampleSite/resources are covered by these.
public/
resources/
.hugo_build.lock
hugo_stats.json

# Vercel CLI project linking (.vercel/project.json holds the org and project
# IDs) and the local build cache that tools/vercel-build.sh points Hugo at.
.vercel/

# Symlinks inside exampleSite that point back into this repo. These are NOT
# covered by the patterns above: a trailing slash matches directories only, and
# git records a symlink as a blob, not a directory. Left tracked,
# exampleSite/themes/uswds would commit a link to "../.." — the repository
# pointing at itself.
exampleSite/node_modules
exampleSite/themes/

# Upstream USWDS reference checkout (~196 MB), used only by
# tools/upgrade-diff.sh. The theme depends on @uswds/uswds from npm; this clone
# is never built against. See DESIGN.md §4.2, enforced by
# tools/check-no-vendored.sh.

/tools/upstream/

# Local tooling and editor state
.claude/settings.local.json
.vscode/
.idea/
*.swp

# OS and logs
.DS_Store
Thumbs.db
*.log

